{
  "name": "transplant",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run -A main.ts",
    "test": "deno test -A",
    "check": "deno check main.ts",
    "compile": "deno compile -A --output transplant main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.6",
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/tar": "jsr:@std/tar@^0.1.10",
    "@std/toml": "jsr:@std/toml@^1.0.2",
    "@std/cli": "jsr:@std/cli@^1.0.9",
    "@anthropic-ai/claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.195"
  },
  "fmt": {
    "exclude": ["scratchpad/", "*.tar"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
